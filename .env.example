# ─── Brand ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_BRAND_NAME="Construction AI Brief"
NEXT_PUBLIC_BRAND_TAGLINE="The honest read on AI in commercial construction."
NEXT_PUBLIC_SITE_URL="https://constructionaibrief.com"

# ─── Beehiiv (only API key the autopilot needs) ───────────────────────────
# Free tier. Manages subscribers, deliverability (DKIM/SPF/DMARC), unsubs.
# Get key at app.beehiiv.com/settings/integrations after creating publication.
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=
BEEHIIV_WEBHOOK_SECRET=

# ─── Beehiiv embed (alt path — no API key needed for signup) ──────────────
# If set, the signup form embeds Beehiiv's hosted iframe instead of POSTing
# to our /api/signup. Use this if you'd rather not manage an API key.
# Format: https://embeds.beehiiv.com/<uuid>?slim=true
NEXT_PUBLIC_BEEHIIV_EMBED_URL=
